# Per-camera configuration. Single source of truth — everything else
# (mediamtx paths, docker-compose detector/feeder services, webui nginx routing,
# the UI's camera picker) is generated from this file by tools/configure.py.
#
# Workflow:
#   cp cameras.yaml.example cameras.yaml
#   $EDITOR cameras.yaml
#   just configure         # regenerates derived files
#   just dev               # docker compose up
#
# Field reference per camera:
#   id              — short slug. Must match [a-z0-9]+ (NO hyphens: the id
#                     becomes a mediamtx path overridden via
#                     MTX_PATHS_<ID>_SOURCE, whose env key can't carry hyphens).
#   rtsp            — full RTSP URL, credentials embedded inline. Don't quote.
#                     If the camera needs auth, embed it like
#                       rtsp://USERNAME : PASSWORD @ 192.168.0.214:554/stream1
#                     (written WITHOUT the spaces — they're here only to keep
#                     credentials out of the committed example). This value is
#                     never written to any committed file: configure.py emits it
#                     to the gitignored secrets/cameras.env as MTX_PATHS_<ID>_SOURCE.
#   label           — optional pretty name for the UI picker.
#   detector_type   — "blob" | "yolo" | "yolo_cat"
#                     yolo_cat: YOLO detects cats, EfficientNet-B0 identifies them.
#   detector_target_fps — max detector processing cadence per camera (default 2.0).
#                     The decoder still drains the stream and the detector keeps
#                     only the latest frame, so this limits CPU without building
#                     a stale backlog. Raise for fast scenes; feeder safety still
#                     relies on the temporal action-zone aggregator below.
#   yolo_weights    — path inside container (default: baked INT8 IR).
#   yolo_conf       — YOLO confidence threshold.
#   classifier_weights  — runtime classifier model dir, served from the shared
#                         read-only volume (default: /opt/models/classifier/current,
#                         switched by `just classifier-promote`).
#   detector_unknown_conf — detector-side identity confidence threshold; below
#                           this the detector records cat="unknown" (default: 0.5).
#                           Legacy alias: classifier_min_conf.
#   classifier_pad_frac — context padding added around each YOLO box BEFORE the
#                         identity classifier runs (default: 0.15). MUST match the
#                         training crop padding in all three places or the
#                         classifier sees different framing at serve vs train time:
#                           detector  CLASSIFIER_PAD_FRAC  (this value)
#                           review    build_cluster_manifest --pad-frac
#                           training  train_classifier     --pad-frac
#                         Change all three together or not at all.
#   rotate_deg      — internal-to-model rotation, 0/90/180/270.
#                     All zones below are still drawn in the camera/UI image
#                     orientation, not in the rotated model input. Different
#                     camera angles should have different per-camera zones.
#   detect_roi      — camera-coord rectangle, "x0,y0,x1,y1" in [0..1].
#   ignore_regions  — optional detector false-positive masks in camera coords.
#                     Detections are dropped before events/review/training only
#                     when most of the detection box is covered by one of these
#                     regions. Use for static objects YOLO confuses for cats,
#                     such as the feeder body/lid. Do NOT put the bowl/food
#                     area here: that would remove real cat detections and
#                     review crops. Use food_region for the bowl instead.
#                     Backward-compatibility: regions named bowl/food are
#                     automatically treated as soft food_region, not hard ignore.
#   ignore_region_min_coverage — fraction of a box that must be inside an
#                     ignore region before it is dropped (default 0.8).
#                     Shapes can be:
#                       ignore_regions:
#                         - name: feeder_body
#                           rect: [0.35, 0.02, 0.68, 0.34]
#                         - name: left_fixture
#                           points: [[0.0,0.4], [0.1,0.4], [0.1,0.8], [0.0,0.8]]
#   decision_polygon — camera-coord polygon where feeder decisions are allowed.
#                     Detections outside it are still shown/recorded, but the
#                     feeder treats them as out-of-zone and will not open from
#                     them. Preferred name; legacy live2 alias: action_polygon.
#                     Define this separately for each camera angle. Coordinates
#                     are normalized fractions of that camera's UI image:
#                     x=0 left, x=1 right, y=0 top, y=1 bottom.
#                     Shapes can be a rect [x0,y0,x1,y1] or N points:
#                       decision_polygon:
#                         - [0.10, 0.20]
#                         - [0.85, 0.20]
#                         - [0.85, 0.95]
#                         - [0.10, 0.95]
#   food_region    — optional bowl/food texture monitor region in the same
#                    camera/UI coordinate convention. No food_region means the
#                    food-level monitor is disabled for this camera. Rect or
#                    polygon are accepted. This is a soft observation zone:
#                    it is shown separately in the UI and never filters cat
#                    detections, feeder decisions, or future review crops.
#   food_empty_level, food_full_level — optional per-camera calibration for the
#                    contrast detector. The monitor's primary signal is how much
#                    DARKER the bowl is than its surrounding ring (food is dark,
#                    an empty tray is bright/glossy). These two numbers are the
#                    raw contrast you observe on this camera when the bowl is
#                    empty vs. full. To get them: leave both unset, watch the
#                    detector log lines "food calib <camera>: raw_contrast=<N>"
#                    (emitted ~every 30s while uncalibrated), and record the
#                    typical value for an empty bowl and a full bowl on THIS
#                    camera. Until both are set, food_state stays "unknown".
#   food_margin_frac — ring width as a fraction of the bowl bbox min side for the
#                    contrast reference (default 0.35).
#   food_texture_weight — blend weight (0..1) for the legacy texture signal on top
#                    of the contrast fill (default 0.0 = contrast only). The
#                    texture knobs below apply only when this is > 0.
#   food_tiles, food_tex_thresh — texture knobs. Defaults: 8, 12.0.
#   food_empty_below, food_full_above — hysteresis on the normalized 0..1 fill
#                    level. Defaults: 0.30, 0.55.
#   food_check_interval_sec, food_median_window — sampling cadence and smoothing
#                    window. Defaults: 5, 10.
#   blob_bright_threshold, blob_min_area — for DETECTOR_TYPE=blob.
#   artificial_delay_ms — initial value for the UI delay slider.
#
#   feeder (optional) — if present, configure.py generates a feeder-<id> service.
#     id             — feeder slug. Must match [a-z0-9-]+.
#     api_base_url   — base URL of the feeder REST API, e.g. http://192.168.0.100
#     serial_number  — hardware serial used in API paths (/api/<serial>/door/...)
#     allowed_cats   — list of cat names allowed to open this feeder. Names must
#                      match class_names in the classifier model. Nothing hardcoded
#                      here — add/remove names freely.
#     dangerous_confusions — optional list of {actual, predicted, action} safety
#                      rules. action "block_open" (default) refuses to open when the
#                      resolved (allowed) identity could really be a NON-allowed cat,
#                      e.g. - {actual: cat_b, predicted: cat_a} means "if the model
#                      says cat_a but might be cat_b, don't open". Default: none.
#     door_close_timeout_sec — seconds without detection before door closes (default 30).
#                             Tolerates missed frames and pose changes.
#     min_meal_sec           — min meal duration (sec) (default 10).
#     presence_window_sec    — sliding window (sec) for n_cats counting and identity
#                             weighted-vote (default 5). Multi-cat requires 2+ frames
#                             with 2+ boxes within this window — single-frame glitches
#                             are ignored. Must be <= door_close_timeout_sec.
#     classifier_min_conf    — feeder-side minimum cat_score to participate in the
#                             identity vote (default 0.9). Frames below this threshold
#                             are silently excluded from voting; "unknown" is always
#                             excluded. Raise this to make identity selection stricter.
#     open_min_confidence    — decision gate (default 0 = off): block the open with
#                             reason "low_confidence" if the winning identity's mean
#                             score is below this. Separate from classifier_min_conf
#                             (which filters who votes).
#     open_min_margin        — decision gate (default 0 = off): block with "low_margin"
#                             if top1−top2 margin < this. Inert until the detector
#                             emits top-2 scores; safe to leave unset.
#     open_debounce_sec      — an allowed+ready cat must stay the dominant open-verdict
#                             continuously for this long before the door opens (default
#                             3). Prevents opening on a momentary glimpse.
#     multi_debounce_sec     — while the door is open, a multi_cat or identity-change
#                             condition must hold this long before the door closes
#                             (default 2). Absorbs single glitch frames (a spurious
#                             second YOLO box, a one-frame misclassification) so the
#                             door does not chatter. present==False still closes after
#                             door_close_timeout_sec with no extra delay.
#     display_text_interval  — seconds for /api/{serial}/display/text updates when
#                             the feeder opens for a recognised cat (default 2).
#     ---- feeding (optional) — dispense food; two mutually exclusive modes ----
#     Every dispense (both modes) is logged to a shared SQLite journal mounted at
#     /data/feed_journal/journal.db (one DB for all feeders).
#     feed_mode              — "empty_bowl" (default) reacts to the bowl monitor, or
#                             "scheduled" feeds at fixed clock times.
#     feed_grain_num         — portions dispensed per feed via /api/<serial>/feed,
#                             both modes (default 1).
#     ---- empty_bowl mode — refill when the bowl reads empty ----
#     Reads the detector's food_state, so it needs a calibrated food_region
#     (food_empty_level / food_full_level above). OFF unless feed_enabled: true.
#     feed_enabled           — true to enable auto-refill (default false = off; the
#                             feeder behaves exactly as before).
#     food_empty_consecutive — consecutive "empty" food_state reads required before a
#                             refill, so a single frame never triggers it (default 2).
#     feed_min_interval_sec  — minimum seconds between refills (default 1800).
#     feed_confirm_timeout_sec — after a refill, wait for food_state to return to
#                             "has_food" (grain settling) before another refill is
#                             allowed, or this many seconds, whichever comes first
#                             (default 120). "unknown" readings are ignored, and no
#                             refill happens while the door is in motion.
#     ---- scheduled mode — feed at fixed clock times ----
#     feed_times             — list of "HH:MM" slots, e.g. ["08:00","13:00","18:00"].
#                             A malformed entry fails the feeder at startup.
#     feed_tz                — IANA tz for the slots, e.g. "Europe/Moscow"
#                             (default: container local tz).
#     feed_catchup_max       — on restart / after downtime, at most this many of the
#                             latest missed slots actually feed; older missed slots
#                             are journaled as "maintenance" (skipped, not dispensed)
#                             so the day's record is complete (default 2).
#
# Globals at the top apply to all cameras.

webrtc_host: 192.168.0.10        # public IP/host the browser dials for WebRTC ICE

cameras:
  - id: living
    label: Living room
    # Embed credentials inline (see rtsp note above); kept bare here.
    rtsp: rtsp://192.168.0.214:554/stream1
    detector_type: yolo_cat
    detector_target_fps: 2.0
    rotate_deg: 0
    decision_polygon:
      - [0.10, 0.20]
      - [0.85, 0.20]
      - [0.85, 0.95]
      - [0.10, 0.95]
    food_region:
      - [0.64, 0.30]
      - [0.94, 0.30]
      - [0.94, 0.78]
      - [0.64, 0.78]
    # Contrast calibration: снять по кадрам полно/пусто этой камеры
    # (watch the "food calib living: raw_contrast=..." log lines first).
    food_empty_level: 4.0     # raw contrast with an empty bowl
    food_full_level: 26.0     # raw contrast with a full bowl
    food_margin_frac: 0.35
    food_texture_weight: 0.0
    food_empty_below: 0.30
    food_full_above: 0.55
    food_check_interval_sec: 5
    food_median_window: 10
    feeder:
      id: feeder1
      api_base_url: http://192.168.0.100
      serial_number: ABC123456
      allowed_cats: [alisa, ellie]
      # Safety gates (recommended). Runtime default is 0/off for back-compat, but
      # ship a safe value here so a copied config isn't wide open. open_min_margin
      # is inert until the detector emits top-2 scores, but harmless to set now.
      open_min_confidence: 0.85
      open_min_margin: 0.15
      # Feeding is optional. Pick ONE mode (mutually exclusive). Every dispense is
      # logged to the shared /data/feed_journal/journal.db regardless of mode.
      #
      # empty_bowl mode (default; needs the calibrated food_region above):
      # feed_mode: empty_bowl
      # feed_enabled: true
      # feed_grain_num: 1
      # food_empty_consecutive: 2
      # feed_min_interval_sec: 1800
      # feed_confirm_timeout_sec: 120
      #
      # scheduled mode (fixed clock times; no food_region needed):
      # feed_mode: scheduled
      # feed_grain_num: 1
      # feed_times: ["08:00", "13:00", "18:00", "22:00"]
      # feed_tz: Europe/Moscow      # default: container local tz
      # feed_catchup_max: 2         # latest N missed slots feed; older = maintenance

  - id: kitchen
    label: Kitchen
    rtsp: rtsp://192.168.0.215:554/stream1
    detector_type: yolo_cat
    rotate_deg: 90
    feeder:
      id: feeder2
      api_base_url: http://192.168.0.101
      serial_number: DEF789012
      allowed_cats: [chuzh]
      open_min_confidence: 0.85   # safety gate (see feeder1 above)
      open_min_margin: 0.15
      # Concrete scheduled example: 1 portion at each of these local times.
      # After a restart, only the latest feed_catchup_max missed slots are fed;
      # older missed slots are journaled as "maintenance" (skipped, not dispensed).
      feed_mode: scheduled
      feed_grain_num: 1
      feed_times: ["08:00", "13:00", "18:00", "22:00"]
      feed_tz: Europe/Moscow      # omit to use the container's local tz
      feed_catchup_max: 2
