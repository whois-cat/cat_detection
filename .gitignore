# Runtime / state — should never live in the repo.
.env
.env~
.env.local
# Per-camera config carries RTSP credentials — commit cameras.yaml.example instead.
cameras.yaml
# Generated camera RTSP sources with credentials (MTX_PATHS_<ID>_SOURCE).
secrets/
data/

# Generated from cameras.yaml by tools/configure.py. These are
# server-specific and should be recreated with `just configure`.
docker-compose.cameras.yml
docker-compose.cameras.dev.yml
mediamtx/mediamtx.yml
webui/nginx.conf
webui/public/cameras.json

# MLflow tracking. The default store lives under data/ (already ignored above);
# mlruns/ guards against a run started from a different cwd.
mlruns/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-review/
venv/

# Node / vite (webui)
webui/node_modules/
webui/dist/
webui/.vite/
*.log
npm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Downloaded model weights (re-fetched on container build).
# Keep training-produced models out unless explicitly committed.
detector/yolov8n.pt
detector/yolov8n_int8_openvino_model/
detector/datasets/

# Classifier checkpoints & promotion artifacts — never commit weights.
# (trained outputs, the runtime model volume, and legacy bake/backups)
models/*.pt
models/trained/
models/backups/
models/classifier/

# Legacy baked classifier checkpoint — no longer used at runtime (model is
# delivered via the models/classifier volume). Untracked with `git rm --cached`.
detector/models/

# Local runtime config — carries real cat/camera names + ${ENV} secret refs.
# Per-deployment, like cameras.yaml; commit a *.example instead if one is added.
configs/

# Generated evaluation/report artifacts.
reports/

# Ultralytics auto-downloads yolov8n.pt into the repo root on first run.
yolov8n.pt
