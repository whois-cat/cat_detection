# Runtime / state — should never live in the repo.
.env
.env~
.env.local
# New stack config (may carry credentials) — commit config.example.yaml instead.
config.yaml
# Credentials (e.g. secrets/streamhub.env).
secrets/
data/
# Human labels (training.reviews also accepts this root-level location).
/reviews.db
# Previous stack's local files (cameras.yaml carries RTSP credentials).
cameras.yaml
docker-compose.cameras*.yml
mediamtx/

# MLflow tracking. The default store lives under data/ (already ignored above);
# mlruns/ guards against a run started from a different cwd.
mlruns/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-review/
venv/

# Node / vite (webui)
webui/node_modules/
webui/dist/
webui/.vite/
*.log
npm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo


# Classifier checkpoints & promotion artifacts — never commit weights.
# (trained outputs, the runtime model volume, and legacy bake/backups)
models/*.pt
models/trained/
models/backups/
models/classifier/


# Local runtime config — carries real cat/camera names + ${ENV} secret refs.
# Per-deployment, like cameras.yaml; commit a *.example instead if one is added.
configs/

# Generated evaluation/report artifacts.
reports/

# Ultralytics auto-downloads yolov8n.pt into the repo root on first run.
yolov8n.pt
