# Copy this file to .env and fill in real values.
# All variables have defaults — .env is optional for local development.

# ── Camera ────────────────────────────────────────────────────────────────────
RTSP_URL=rtsp://camera:password@192.168.0.213:554/stream1

# ── Live detection ────────────────────────────────────────────────────────────
LIVE_THRESHOLD=0.6
INFERENCE_FPS=5
RECLASSIFY_EVERY=30
# Comma-separated cat allowlist for the feeder (default: all except felisis)
FEEDER_ALLOWED_CATS=

# ── Feeder API ────────────────────────────────────────────────────────────────
# Base URL of the feeder REST API; leave empty to disable feeder integration
FEEDER_API_URL=
# Close the door after this many seconds with no cat in frame
DOOR_CLOSE_TIMEOUT_SEC=30

# ── Multi-cat snapshots ───────────────────────────────────────────────────────
MULTI_CAT_SNAPSHOT_RETENTION_DAYS=30

# ── Live crop saving (for retraining) ─────────────────────────────────────────
# Seconds between saved crops per track for known (confident) cats
CROP_SAVE_COOLDOWN=10
# Delete crops older than this many days
CROP_RETENTION_DAYS=60

# ── Web viewer (MJPEG) ────────────────────────────────────────────────────────
# Set to a port number to enable; leave unset or 0 to disable
WEB_PORT=9082

# ── Ports ─────────────────────────────────────────────────────────────────────
PORT_AIRFLOW=9081
PORT_MLFLOW=9050
PORT_VICTORIAMETRICS=9428
PORT_GRAFANA=9300

# ── Passwords ─────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Service URLs (override when running scripts outside Docker) ───────────────
# Internal Docker network URLs — use container name + internal port
MLFLOW_TRACKING_URI=http://mlflow:5050
VM_URL=http://victoriametrics:8428

# ── VictoriaMetrics ───────────────────────────────────────────────────────────
VM_RETENTION=365d
