RTSP_URL=rtsp://camera:CHANGEME@192.168.0.214:554/stream1

# Public IP/host that browsers will reach for WebRTC.
# For LAN-only use, this is the docker host's LAN IP.
WEBRTC_HOST=192.168.0.10

# Note: hard retention cap for on-disk recordings is set in
# mediamtx/mediamtx.yml (recordDeleteAfter, default 720h = 30 days).
# Day-to-day pruning is detection-aware, see PRUNER_* knobs below.

# Camera identifier — tags every event in the DB. Set to something
# meaningful when running multiple cameras ('living-room', etc.).
CAMERA_ID=default

# Which detector to run: 'blob' (dummy, for testing with flashlight) or
# 'yolo' (Ultralytics YOLO).
DETECTOR_TYPE=blob

# Bright-blob detector knobs (DETECTOR_TYPE=blob)
BLOB_BRIGHT_THRESHOLD=240
BLOB_MIN_AREA=500

# YOLO detector knobs (DETECTOR_TYPE=yolo)
# Default = pre-quantised INT8 OpenVINO IR (built into the image, ~3-4× faster
# than torch CPU). Use 'yolov8n.pt' to run the original torch weights instead.
YOLO_WEIGHTS=/opt/models/yolov8n_int8_openvino_model/
YOLO_CONF=0.25

# Regions as fractions of full frame, comma-separated, values in [0..1].
# Default for both = full frame (overlay hidden).
#
# DETECT_ROI: axis-aligned rectangle (x0,y0,x1,y1) — crop fed to the model.
# Pixels outside are invisible to it. Rect-only because we slice the frame with
# it. Examples:   left half 0,0,0.5,1     bottom half 0,0.5,1,1
DETECT_ROI=0,0,1,1
#
# ACTION_POLYGON: closed polygon, flat list of vertices x0,y0,x1,y1,x2,y2,...
# Used as a box-center gate for *triggering an action* (feeder, etc.) — the
# model still detects/tracks outside, but acting only happens once a box's
# center lands inside the polygon. A polygon (vs. a rect) accommodates camera
# perspective. 4 values = axis-aligned rect (back-compat shortcut), more =
# explicit polygon. Example trapezoid:  0.2,0.4, 0.8,0.4, 0.9,1, 0.1,1
ACTION_POLYGON=0,0,1,1

# Clockwise rotation (degrees) applied to decoded frames before detection.
# Use this when the camera is mounted sideways and has no firmware rotate
# option — YOLO is not rotation-invariant, so an unrotated sideways frame
# tanks recall. The UI CSS-rotates the live + history video by the same
# amount so what you see matches what the detector saw. ROIs above are
# authored against the *rotated* (upright) view.
# Allowed: 0, 90, 180, 270.
FRAME_ROTATE_DEG=0

# Web UI port (host)
WEB_PORT=8090

# Artificial detector delay (ms). Simulates a slow model for testing
# adaptive playoutDelayHint. Dynamically adjustable via the UI slider.
ARTIFICIAL_DELAY_MS=0

# Pruner — deletes recording segments that have no detection within ±roll
# margin. Recent segments are always kept whole; only ages out beyond
# KEEP_RECENT_HOURS get detection-filtered. mediamtx's recordDeleteAfter
# (in mediamtx.yml) is the absolute hard cap.
PRUNER_PRE_ROLL_SEC=30
PRUNER_POST_ROLL_SEC=30
PRUNER_KEEP_RECENT_HOURS=24
PRUNER_INTERVAL_SEC=3600
# PRUNER_DRY_RUN=1     # uncomment to see what would be deleted without acting
