# Host-level knobs for docker compose and just. Everything else lives in
# config.yaml; credentials in secrets/streamhub.env.

# Web UI / API port on the host, and the address it listens on: 127.0.0.1
# behind a reverse proxy (default), 0.0.0.0 to expose it directly (no auth!).
STREAMHUB_PORT=8096
STREAMHUB_BIND=127.0.0.1
# MLflow UI, likewise.
MLFLOW_PORT=5000
MLFLOW_BIND=127.0.0.1
# Time zone for container logs (decider's scheduled feeding uses feed.tz).
TZ=America/Chicago
# Previous stack's recordings (training): timezone of their file names.
RECORDING_TZ=UTC

# Set to 1 on a machine that must never drive the real feeders (e.g. testing
# with the production config.yaml): decider then decides but doesn't act.
DECIDER_DRY_RUN=

# Label Studio for YOLO box review (`just yolo-label` / `just yolo-sync`).
# Optional, standalone, localhost-only. Log in once with these, then paste the
# access token from Account & Settings into LABEL_STUDIO_API_KEY.
LABEL_STUDIO_PORT=8080
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=change-me-12345
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
